# 复制为 deploy/.env。只填写一种供应商的密钥，不要提交实际配置。
# Windows 路径使用正斜杠；相对路径以项目根目录为基准。
LOOPSMITH_WORKSPACE=.
LOOPSMITH_IMAGE=loopsmith:local
LOOPSMITH_UID=1000
LOOPSMITH_GID=1000

LOOPSMITH_LLM_PROVIDER=anthropic
LOOPSMITH_LLM_DEFAULT_MODEL=deepseek-v4-flash
LOOPSMITH_LLM_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
HKU_API_KEY=
LOOPSMITH_MAX_STEPS=20
LOOPSMITH_LLM_MAX_OUTPUT_TOKENS=4096
LOOPSMITH_LLM_TIMEOUT_S=120

# Anthropic：provider=anthropic，填写 ANTHROPIC_API_KEY，模型与 base_url 改为对应配置。
# HKU：provider=hku，填写 HKU_API_KEY，模型名必须与学校部署名一致。
# HKU 接口示例：https://api.hku.hk/foundry/student/models

# 可选代理：容器内不能使用宿主机 127.0.0.1；代理必须可从 Docker 访问。
# 构建代理只作用于依赖安装，不会写入最终镜像的环境配置。
LOOPSMITH_BUILD_PROXY=
LOOPSMITH_CONTAINER_PROXY=
# Windows Docker Desktop 示例：http://host.docker.internal:7890
# 镜像拉取由 Docker Desktop/daemon 的代理设置管理，不由上述构建参数控制。
